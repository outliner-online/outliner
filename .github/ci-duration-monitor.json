{
    "workflows": [
        {
            "path": ".github/workflows/ci.yml",
            "families": [
                {
                    "key": "unit-tests",
                    "name": "Unit tests",
                    "job_pattern": "^(?:unit-test / )?unit-test$",
                    "test_step_pattern": "^Run unit tests$",
                    "source_paths": [
                        ".github/workflows/ci-test-unit.yml",
                        "client/package.json",
                        "client/vite.config.ts",
                        ".github/actions/setup-test-env/action.yml",
                        "client/vitest.base.config.ts"
                    ],
                    "guidance": "Inspect the unit Vitest project and native test durations. Split or rebalance complete test selections only when the test step is the bottleneck; preserve the unit and base-path coverage checks and failure propagation.",
                    "measurement": "test-step"
                },
                {
                    "key": "integration-tests",
                    "name": "Integration tests",
                    "job_pattern": "^(?:integration-test / )?integration-test$",
                    "test_step_pattern": "^Run integration tests$",
                    "source_paths": [
                        ".github/workflows/ci-test-integration.yml",
                        "client/package.json",
                        "client/vite.config.ts",
                        ".github/actions/setup-test-env/action.yml"
                    ],
                    "guidance": "Inspect integration test durations and fixture requirements before partitioning the selection. Preserve every integration test, emulator-backed behavior and native failure propagation.",
                    "measurement": "test-step"
                },
                {
                    "key": "server-tests",
                    "name": "Server tests",
                    "job_pattern": "^(?:server-test / )?server-test$",
                    "test_step_pattern": "^Run server tests$",
                    "source_paths": [
                        ".github/workflows/ci-test-server.yml",
                        "server/package.json",
                        ".github/actions/setup-test-env/action.yml",
                        "scripts/run-server-tests.sh",
                        "scripts/run-server-test-command.sh",
                        "scripts/setup.sh",
                        "server/tests/loaders/pin-server-deps.mjs"
                    ],
                    "guidance": "Inspect the Mocha server test command and native file durations. Preserve test discovery, required service setup and original failures when splitting or rebalancing the suite.",
                    "measurement": "test-step"
                },
                {
                    "key": "project-directory-tests",
                    "name": "Project directory tests",
                    "job_pattern": "^(?:server-test / )?project-directory-test$",
                    "test_step_pattern": "^Run canonical project directory tests$",
                    "source_paths": [
                        ".github/workflows/ci-test-server.yml",
                        "server/package.json",
                        "server/tests/loaders/pin-server-deps.mjs",
                        ".github/actions/setup-test-env/action.yml"
                    ],
                    "guidance": "Inspect the canonical project directory, provider, websocket and cloud entrypoint tests. Preserve all four explicitly selected files and their real emulator behavior.",
                    "measurement": "test-step"
                },
                {
                    "key": "e2e-chromium",
                    "name": "Chromium E2E tests",
                    "job_pattern": "^(?:e2e-test / )?e2e-test \\((?!firefox-)(?!new-[23]\\))[^)]+\\)$",
                    "test_step_pattern": "^Run E2E tests \\(",
                    "source_paths": [
                        ".github/workflows/ci-test-e2e.yml",
                        "client/playwright.config.ts",
                        "client/package.json",
                        ".github/actions/setup-e2e-deps/action.yml",
                        "scripts/ci/run-e2e-startup.sh",
                        "scripts/ci/verify-startup-evidence.py",
                        "scripts/ci/run-bounded-e2e.py",
                        "scripts/test-onprem-client.sh",
                        "client/e2e/reporters/firefox-selection-reporter.ts"
                    ],
                    "guidance": "Compare native Playwright durations across every Chromium project. Existing new-2, new-3 and tables partitions already have coverage and completion guards; preserve the exact collected selection, browser coverage, artifact identity and failure aggregation. Separate dependency/service startup from test execution before choosing further sharding.",
                    "measurement": "test-step",
                    "diagnostic_job_pattern": "^(?:e2e-test / )?e2e-test \\(onprem\\)$"
                },
                {
                    "key": "e2e-firefox",
                    "name": "Firefox E2E tests",
                    "job_pattern": "^(?:e2e-test / )?e2e-test \\(firefox-[^)]+\\)$",
                    "test_step_pattern": "^Run E2E tests \\(",
                    "source_paths": [
                        ".github/workflows/ci-test-e2e.yml",
                        "client/playwright.config.ts",
                        "client/package.json",
                        ".github/actions/setup-e2e-deps/action.yml",
                        "scripts/ci/run-e2e-startup.sh",
                        "scripts/run-firefox-selection.mjs",
                        "scripts/ci/verify-startup-evidence.py",
                        "scripts/ci/run-bounded-e2e.py",
                        "scripts/test-onprem-client.sh",
                        "client/e2e/reporters/firefox-selection-reporter.ts"
                    ],
                    "guidance": "Inspect the Firefox selection runner and actual browser execution receipts. Keep Firefox separate from Chromium; preserve its complete curated selection, zero-test rejection and failure evidence when balancing work.",
                    "measurement": "test-step"
                }
            ]
        },
